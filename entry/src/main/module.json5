{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "2in1",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:clipboard_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "extensionAbilities": [
      {
        "name": "ClahsosVpnAbility",
        "srcEntry": "./ets/vpnability/ClahsosVpnAbility.ets",
        "type": "vpn",
        "label": "$string:vpn_label",
        "description": "$string:vpn_description",
        "icon": "$media:app_icon",
        "exported": false
      }
    ],
    "abilities": [
      {
        "name": "TrayResidentAbility",
        "srcEntry": "./ets/entryability/TrayResidentAbility.ets",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:app_background",
        "launchType": "singleton",
        "exported": false
      },
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:app_background",
        "launchType": "singleton",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              { "scheme": "clash", "host": "install-config" },
              { "scheme": "clashos", "host": "install-config" },
              { "scheme": "clash-verge", "host": "install-config" }
            ]
          }
        ]
      }
    ]
  }
}
